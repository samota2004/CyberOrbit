generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  EMPLOYEE
  MANAGER
  SECURITY_ADMIN
  SYSTEM_ADMIN
}

enum DepartmentType {
  HR
  FINANCE
  ENGINEERING
  SALES
  LEGAL
  EXECUTIVE
  SECURITY
  IT
}

enum AccountStatus {
  ACTIVE
  FROZEN
  INVESTIGATION
  DISABLED
}

enum DeviceStatus {
  TRUSTED
  MONITORED
  SUSPICIOUS
  REVOKED
}

enum ResourceSensitivity {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  HIGHLY_SENSITIVE
}

enum EventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  FILE_ACCESS
  FILE_DOWNLOAD
  PRIVILEGE_ELEVATION
  USB_TRANSFER
  POLICY_VIOLATION
  UNUSUAL_HOURS_ACCESS
  CROSS_DEPT_ACCESS
  MASS_DOWNLOAD
}

enum EventSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PolicyAction {
  ALLOW
  MONITOR
  MFA
  REQUIRE_APPROVAL
  RESTRICT
  FREEZE
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  NEW
  INVESTIGATING
  CONTAINED
  RESOLVED
  FALSE_POSITIVE
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MfaSessionStatus {
  PENDING
  VERIFIED
  EXPIRED
  FAILED
}

model Department {
  id          String         @id @default(cuid())
  code        DepartmentType @unique
  name        String
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  users     User[]
  resources Resource[]

  @@map("departments")
}

model Role {
  id          String   @id @default(cuid())
  code        UserRole @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@map("roles")
}

model User {
  id                String         @id @default(cuid())
  employeeId        String         @unique
  name              String
  email             String         @unique
  passwordHash      String?
  passwordChangedAt DateTime?
  avatarUrl         String?
  roleCode          UserRole       @default(EMPLOYEE)
  role              Role?          @relation(fields: [roleCode], references: [code])
  departmentCode    DepartmentType @default(ENGINEERING)
  department        Department?    @relation(fields: [departmentCode], references: [code])
  status            AccountStatus  @default(ACTIVE)
  isMainAdmin       Boolean        @default(false)

  riskScore  Float         @default(10)
  trustScore Float         @default(90)
  riskLevel  EventSeverity @default(LOW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  behaviorProfile     BehaviorProfile?
  devices             Device[]
  activityEvents      ActivityEvent[]
  incidents           Incident[]
  accessRequests      AccessRequest[]      @relation("UserAccessRequests")
  reviewedRequests    AccessRequest[]      @relation("ReviewerAccessRequests")
  trustHistories      TrustHistory[]
  riskScores          RiskScore[]
  sessions            Session[]
  mfaSessions         MfaSession[]
  passwordResetTokens PasswordResetToken[]
  mlPredictions       MlPrediction[]
  auditLogs           AuditLog[]

  @@index([roleCode])
  @@index([departmentCode])
  @@index([status])
  @@index([riskScore])
  @@index([trustScore])
  @@map("users")
}

model BehaviorProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  normalStartHour     Int      @default(9)
  normalEndHour       Int      @default(18)
  avgDailyDownloadsMB Float    @default(50.0)
  maxNormalDownloadMB Float    @default(200.0)
  typicalLocations    String[] @default(["San Francisco, USA", "HQ Network"])
  allowedDepartments  String[] @default(["ENGINEERING"])
  knownIpSubnets      String[] @default(["10.0.0.0/16", "192.168.1.0/24"])
  offHoursAccessRate  Float    @default(0.02)
  crossDeptAccessRate Float    @default(0.01)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("behavior_profiles")
}

model Device {
  id       String @id @default(cuid())
  deviceId String @unique
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  os          String
  browser     String
  ip          String
  location    String
  trustScore  Float        @default(90)
  isTrusted   Boolean      @default(true)
  status      DeviceStatus @default(TRUSTED)
  fingerprint String?

  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityEvents ActivityEvent[]

  @@index([userId])
  @@index([status])
  @@index([trustScore])
  @@index([ip])
  @@map("devices")
}

model Resource {
  id             String              @id @default(cuid())
  resourceId     String              @unique
  name           String
  departmentCode DepartmentType
  department     Department?         @relation(fields: [departmentCode], references: [code])
  sensitivity    ResourceSensitivity @default(INTERNAL)
  requiredRoles  UserRole[]          @default([EMPLOYEE])
  description    String?
  accessCount    Int                 @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityEvents ActivityEvent[]
  accessRequests AccessRequest[]

  @@index([departmentCode])
  @@index([sensitivity])
  @@map("resources")
}

model ActivityEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userEmail String
  userRole  UserRole

  deviceId   String?
  device     Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  deviceName String?

  resourceId   String?
  resource     Resource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  resourceName String?

  type      EventType
  timestamp DateTime      @default(now())
  ip        String
  location  String
  severity  EventSeverity @default(INFO)

  riskContribution  Float   @default(0)
  mlAnomalyScore    Float?
  isOffHours        Boolean @default(false)
  isCrossDepartment Boolean @default(false)
  downloadSizeMB    Float?
  failedAttempts    Int?    @default(0)
  metadata          Json?

  incidentId String?
  incident   Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([deviceId])
  @@index([resourceId])
  @@index([type])
  @@index([severity])
  @@index([timestamp])
  @@map("activity_events")
}

model RiskScore {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  score        Float
  level        EventSeverity
  factors      Json
  anomalyScore Float?
  timestamp    DateTime      @default(now())

  @@index([userId])
  @@index([timestamp])
  @@map("risk_scores")
}

model TrustHistory {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  trustScore Float
  riskScore  Float
  reason     String
  delta      Float    @default(0)
  timestamp  DateTime @default(now())

  @@index([userId])
  @@index([timestamp])
  @@map("trust_histories")
}

model Incident {
  id          String           @id @default(cuid())
  incidentId  String           @unique
  title       String
  description String?
  severity    IncidentSeverity @default(MEDIUM)
  status      IncidentStatus   @default(NEW)

  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userEmail String

  riskScore           Float
  contributingFactors String[]
  mitreTechnique      String?
  aiExplanation       String?
  recommendedAction   String?
  resolutionNotes     String?
  resolvedAt          DateTime?
  resolvedBy          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityEvents ActivityEvent[]

  @@index([userId])
  @@index([status])
  @@index([severity])
  @@index([createdAt])
  @@map("incidents")
}

model AccessRequest {
  id        String @id @default(cuid())
  requestId String @unique
  userId    String
  user      User   @relation("UserAccessRequests", fields: [userId], references: [id], onDelete: Cascade)

  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  justification    String
  status           AccessRequestStatus @default(PENDING)
  riskAtRequest    Float               @default(0)
  aiRiskAssessment String?

  reviewedBy        String?
  reviewer          User?     @relation("ReviewerAccessRequests", fields: [reviewedBy], references: [id], onDelete: SetNull)
  decisionReason    String?
  decisionTimestamp DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([resourceId])
  @@index([status])
  @@index([createdAt])
  @@map("access_requests")
}

model AuditLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail String?

  action   String
  category String
  severity EventSeverity @default(INFO)
  details  String
  ip       String?       @default("127.0.0.1")
  metadata Json?

  @@index([userId])
  @@index([category])
  @@index([severity])
  @@index([timestamp])
  @@map("audit_logs")
}

model ZeroTrustPolicy {
  id       String  @id @default(cuid())
  name     String  @default("Default Enterprise Zero Trust Policy")
  isActive Boolean @default(true)

  // Risk thresholds (0 - 100)
  lowRiskMax        Float @default(25)
  mediumRiskMax     Float @default(50)
  highRiskMax       Float @default(75)
  veryHighRiskMax   Float @default(90)
  criticalThreshold Float @default(90)

  // Action triggers
  mfaThreshold         Float @default(40)
  approvalThreshold    Float @default(60)
  restrictionThreshold Float @default(75)
  freezeThreshold      Float @default(90)

  // Weights
  offHoursWeight    Float @default(20)
  crossDeptWeight   Float @default(25)
  volumeWeight      Float @default(25)
  deviceTrustWeight Float @default(15)
  failedLoginWeight Float @default(15)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("zero_trust_policies")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip           String
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([sessionToken])
  @@map("sessions")
}

model MfaSession {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeHash  String
  status         MfaSessionStatus @default(PENDING)
  action         String?
  targetResource String?
  attempts       Int              @default(0)
  maxAttempts    Int              @default(5)
  expiresAt      DateTime
  verifiedAt     DateTime?
  createdAt      DateTime         @default(now())

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@map("mfa_sessions")
}

model PasswordResetToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model ModelVersion {
  id              String   @id @default(cuid())
  modelName       String
  version         String
  rocAuc          Float    @default(0.978)
  precision       Float    @default(0.962)
  recall          Float    @default(0.954)
  f1Score         Float    @default(0.958)
  trainingDataset String   @default("CERT Insider Threat Dataset r4.2")
  featureCount    Int      @default(12)
  isActive        Boolean  @default(true)
  metadata        Json?
  createdAt       DateTime @default(now())

  predictions MlPrediction[]

  @@map("model_versions")
}

model MlPrediction {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  modelVersionId String?
  modelVersion   ModelVersion? @relation(fields: [modelVersionId], references: [id], onDelete: SetNull)

  featureVector Json
  anomalyScore  Float
  isAnomalous   Boolean
  riskScore     Float
  attributions  Json

  timestamp DateTime @default(now())

  @@index([userId])
  @@index([isAnomalous])
  @@index([timestamp])
  @@map("ml_predictions")
}
